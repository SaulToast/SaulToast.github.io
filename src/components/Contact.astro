---
import { contact } from '../data/contact';
const resumeHref = contact.resume?.startsWith('/')
  ? `${import.meta.env.BASE_URL}${contact.resume.slice(1)}`
  : contact.resume;
const destinations = [
  { title: 'Email', label: 'Start a conversation', href: contact.email ? `mailto:${contact.email}` : null, detail: contact.email, icon: 'email' },
  { title: 'LinkedIn', label: 'View my profile', href: contact.linkedin, detail: null, icon: 'profile' },
  { title: 'Résumé', label: 'View my résumé', href: resumeHref, detail: null, icon: 'document' },
  ...(contact.github ? [{ title: 'GitHub', label: 'Explore public work', href: contact.github, detail: null, icon: 'code' }] : []),
];
---
<section id="contact" class="contact-section wrap" aria-labelledby="contact-heading">
  <div class="contact-heading">
    <div><p class="eyebrow">Contact &amp; résumé</p><h2 id="contact-heading">Let’s connect<span class="heading-dot">.</span></h2></div>
    <p>Get in touch, find my professional profile, or take a closer look at my background.</p>
  </div>
  <div class="contact-grid">
    {destinations.map(destination => {
      const Tag = destination.href ? 'a' : 'div';
      return (
        <Tag href={destination.href || undefined} class:list={['contact-card', { 'contact-card-pending': !destination.href }]}>
          <div class="contact-card-top">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {destination.icon === 'email' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
              {destination.icon === 'profile' && <><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="12" cy="9" r="2.5" /><path d="M7 18c0-5 10-5 10 0" /></>}
              {destination.icon === 'document' && <><path d="M14 3H5v18h14V8Z M14 3v5h5 M8 12h8 M8 16h6" /></>}
              {destination.icon === 'code' && <><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 20" /></>}
            </svg>
            {destination.href ? <span class="contact-arrow" aria-hidden="true">↗</span> : <span class="contact-pending-label">Not added yet</span>}
          </div>
          <h3>{destination.title}</h3>
          <p>{destination.href ? destination.label : 'Details coming soon'}</p>
          {destination.detail && <span class="contact-detail">{destination.detail}</span>}
        </Tag>
      );
    })}
  </div>
</section>

<style>
  .contact-section { padding-block: 56px 64px; border-top: 1px solid var(--line); }
  .contact-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 36px; margin-bottom: 30px; }
  .contact-heading h2 { font-size: clamp(36px, 4.2vw, 54px); margin-top: 12px; }
  .contact-heading > p { font-size: 17px; line-height: 1.8; max-width: 48ch; color: var(--text); }
  .contact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .contact-card { display: block; padding: 26px; border: 1px solid var(--accent); background: linear-gradient(135deg, #263742, #1b252ce6); border-radius: 4px; min-width: 0; transition: border-color .2s, background-color .2s, transform .2s; }
  a.contact-card:hover { border-color: var(--text); background-color: #314754; transform: translateY(-3px); }
  .contact-card-pending { border: 1px dashed #526672; background: #1b252c99; }
  .contact-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 28px; margin-bottom: 26px; }
  .contact-icon { height: 27px; width: 27px; color: #a6c1d0; flex-shrink: 0; }
  .contact-arrow { font-size: 25px; }
  .contact-pending-label { font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .contact-card h3 { font-size: 25px; font-weight: 500; letter-spacing: -.025em; }
  .contact-card p { font-size: 16px; line-height: 1.7; margin-top: 8px; }
  .contact-card-pending p { color: var(--muted); }
  .contact-detail { display: block; font-size: 14px; line-height: 1.6; margin-top: 14px; overflow-wrap: anywhere; }
  @media (min-width: 1001px) { .contact-grid:has(> :nth-child(4)) { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 701px) and (max-width: 1000px) { .contact-grid:has(> :nth-child(4)) { grid-template-columns: repeat(2, minmax(0, 1fr)); } .contact-card { padding: 20px; } }
  @media (max-width: 700px) {
    .contact-section { padding-block: 38px 42px; }
    .contact-heading { grid-template-columns: 1fr; gap: 18px; }
    .contact-grid { grid-template-columns: 1fr; gap: 16px; }
    .contact-card { padding: 24px; }
    .contact-card-top { margin-bottom: 18px; }
  }
</style>
