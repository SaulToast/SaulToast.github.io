---
interface Props { label: string; steps: string[]; }
const { label, steps } = Astro.props;
---
<figure class="process-flow" aria-label={label}>
  <figcaption>{label}</figcaption>
  <ol>{steps.map(step => <li>{step}</li>)}</ol>
</figure>
<style>
  .process-flow { margin-block: 24px 30px; }
  .process-flow figcaption { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-bottom: 14px; }
  .process-flow ol { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px 28px; padding: 0; list-style: none; margin: 0; }
  .process-flow li { position: relative; flex: 1 1 120px; padding: 12px 16px; margin: 0; border: 1px solid var(--line); border-top-color: var(--project-accent); background: var(--surface); font-size: 15px; line-height: 1.6; border-radius: 3px; }
  .process-flow li:not(:last-child)::after { content: '→'; position: absolute; right: -23px; top: 12px; color: var(--project-accent); }
  @media (max-width: 700px) {
    .process-flow ol { display: grid; gap: 22px; }
    .process-flow li:not(:last-child)::after { content: '↓'; right: auto; left: 22px; top: auto; bottom: -24px; }
  }
</style>
