---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientBackground from '../components/AmbientBackground.astro';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Saul Hanson — Gameplay & Systems Programmer',
  description = 'Game development portfolio of Saul Hanson. Featured projects: Ultrawave and Lantern of Souls. Technical case studies in preparation.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111920" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body id="top">
    <AmbientBackground />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
